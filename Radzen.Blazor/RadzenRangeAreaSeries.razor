@using Radzen.Blazor
@using Radzen.Blazor.Rendering
@typeparam TItem
@inherits Radzen.Blazor.CartesianSeries<TItem>

<CascadingValue Value="@this">
  @ChildContent
</CascadingValue>
@code {
    public override RenderFragment Render(ScaleBase categoryScale, ScaleBase valueScale)
    {
        var chart = RequireChart();
        var category = ComposeCategory(categoryScale);
        var pathGenerator = GetPathGenerator();

        var min = Min;
        var max = Max;

        var upperList = Items.Select(item =>
        {
            var x = category(item);
            var y = valueScale.Scale(max(item), true);
            return new Point<TItem> { X = x, Y = y, Data = item };
        }).ToList();

        var lowerList = Items.Select(item =>
        {
            var x = category(item);
            var y = valueScale.Scale(min(item), true);
            return new Point<TItem> { X = x, Y = y, Data = item };
        }).ToList();

        Func<int, bool> isEmpty = i => IsEmpty(upperList[i].X, upperList[i].Y, lowerList[i].Y);
        var upperSegments = Segments(upperList, isEmpty);
        var lowerSegments = Segments(lowerList, isEmpty);

        var index = chart.Series.IndexOf(this);
        var className = $"rz-range-area-series {SeriesClass}";
        var gradientId = $"rzRangeAreaGradient{chart.UniqueID}{index}";
        var gradientColor = Fill ?? "var(--rz-series-color)";

        return
        @<g class="@className">
            @if (upperSegments.Count > 0)
            {
                var style = $"clip-path: url(#{chart.ClipPath}); -webkit-clip-path: url(#{chart.ClipPath});";

                var areas = new List<string>();
                var upperLines = new List<string>();
                var lowerLines = new List<string>();

                for (var segmentIndex = 0; segmentIndex < upperSegments.Count; segmentIndex++)
                {
                    var upper = upperSegments[segmentIndex];
                    var lower = lowerSegments[segmentIndex];

                    if (Interpolation == Interpolation.Step)
                    {
                        // Build the fill as independent rectangles per step interval.
                        // A single polygon creates a fold at the last X where the connector
                        // and return path cancel under SVG's nonzero winding rule.
                        var areaPath = new System.Text.StringBuilder();

                        for (var i = 0; i < upper.Count - 1; i++)
                        {
                            areaPath.Append($"M {upper[i].X.ToInvariantString()} {upper[i].Y.ToInvariantString()} ");
                            areaPath.Append($"H {upper[i + 1].X.ToInvariantString()} ");
                            areaPath.Append($"V {lower[i].Y.ToInvariantString()} ");
                            areaPath.Append($"H {upper[i].X.ToInvariantString()} Z ");
                        }

                        areas.Add(areaPath.ToString());

                        // Build stroke paths matching the fill: H-V for intermediate
                        // transitions, H only for the last point (no vertical drop that
                        // would extend past the fill at the right edge).
                        var upperStroke = new System.Text.StringBuilder();
                        var lowerStroke = new System.Text.StringBuilder();

                        upperStroke.Append($"M {upper[0].X.ToInvariantString()} {upper[0].Y.ToInvariantString()}");
                        lowerStroke.Append($"M {lower[0].X.ToInvariantString()} {lower[0].Y.ToInvariantString()}");

                        for (var i = 1; i < upper.Count - 1; i++)
                        {
                            upperStroke.Append($" H {upper[i].X.ToInvariantString()} V {upper[i].Y.ToInvariantString()}");
                            lowerStroke.Append($" H {lower[i].X.ToInvariantString()} V {lower[i].Y.ToInvariantString()}");
                        }

                        if (upper.Count > 1)
                        {
                            var last = upper.Count - 1;
                            upperStroke.Append($" H {upper[last].X.ToInvariantString()}");
                            lowerStroke.Append($" H {lower[last].X.ToInvariantString()}");
                        }

                        upperLines.Add(upperStroke.ToString());
                        lowerLines.Add(lowerStroke.ToString());
                    }
                    else
                    {
                        var upperPath = pathGenerator.Path(upper);
                        var lowerPathForward = pathGenerator.Path(lower);
                        var lowerPathReversed = pathGenerator.Path(lower.AsEnumerable().Reverse());
                        areas.Add($"M {upperPath} L {lowerPathReversed} Z");
                        upperLines.Add($"M {upperPath}");
                        lowerLines.Add($"M {lowerPathForward}");
                    }
                }

                var area = string.Join(" ", areas);
                var upperLine = string.Join(" ", upperLines);
                var lowerLine = string.Join(" ", lowerLines);

                @if (FillMode == FillMode.Gradient)
                {
                    <defs>
                        <linearGradient id="@gradientId" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0" style="@($"stop-color: {gradientColor}; stop-opacity: {GradientStartOpacity.ToInvariantString()}")"></stop>
                            <stop offset="1" style="@($"stop-color: {gradientColor}; stop-opacity: {GradientEndOpacity.ToInvariantString()}")"></stop>
                        </linearGradient>
                    </defs>
                }
                @if (FillMode != FillMode.None)
                {
                    var fill = FillMode == FillMode.Gradient ? $"url(#{gradientId})" : Fill;
                    <path @key="@area" style="@style" d="@area" fill="@fill" stroke="none"></path>
                }
                <Path @key="@upperLine" D="@upperLine" Stroke="@Stroke" StrokeWidth="@StrokeWidth" LineType="@LineType" FlatEnds="true" Style="@style" Fill="none" />
                <Path @key="@lowerLine" D="@lowerLine" Stroke="@Stroke" StrokeWidth="@StrokeWidth" LineType="@LineType" FlatEnds="true" Style="@style" Fill="none" />
            }
        </g>;
    }
}
