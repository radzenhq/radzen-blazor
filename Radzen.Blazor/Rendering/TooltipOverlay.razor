@using Radzen.Blazor
@implements IDisposable

@Chart?.RenderTooltipOverlay()
@if (Chart?.AllowKeyboardNavigation == true)
{
    <div class="rz-chart-announcement" aria-live="polite" aria-atomic="true" style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;">@Chart.KeyboardAnnouncement</div>
}

@code {
    [Parameter]
    public RadzenChart? Chart { get; set; }

    internal bool BoxWasVisible { get; private set; }

    protected override void OnInitialized()
    {
        if (Chart != null)
        {
            Chart.TooltipOverlay = this;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        BoxWasVisible = Chart?.CategoryTooltipRendered ?? false;
    }

    internal void Refresh()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        if (Chart != null && ReferenceEquals(Chart.TooltipOverlay, this))
        {
            Chart.TooltipOverlay = null;
        }
    }
}
