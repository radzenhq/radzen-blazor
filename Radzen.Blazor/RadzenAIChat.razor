@using Radzen
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

@inherits RadzenComponent

@inject IAIChatService ChatService

@if (Visible)
{
    <div @ref="@Element" @attributes="Attributes" class="@GetCssClass()" style="@Style" id="@GetId()" >
        <!-- Chat Header -->
        @if (!string.IsNullOrWhiteSpace(Title) || ShowClearButton)
        {       
            <RadzenStack class="rz-chat-header" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem">
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <span class="rz-chat-header-title">@Title</span>
                }
                <RadzenStack class="rz-chat-header-actions" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.5rem">
                @if (ShowClearButton)
                {
                    <RadzenButton Icon="delete_history" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" 
                                Click="@OnClearChat" Title="@Localize(nameof(RadzenStrings.AIChat_ClearChatTitle))" class="rz-chat-header-clear" />
                }
                </RadzenStack>
            </RadzenStack>
        }

        <!-- Chat Messages -->
        <div class="rz-chat-messages" @ref="messagesContainer">
            @if (Messages.Count == 0)
            {
                if (EmptyTemplate != null)
                {
                    @EmptyTemplate    
                }
                else
                {
                <RadzenStack class="rz-chat-empty" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="1rem">
                    <RadzenIcon Icon="chat_bubble_outline" class="rz-text-secondary-color" />
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-2 rz-text-tertiary-color">@EmptyMessage</RadzenText>
                </RadzenStack>
                }
            }
            else
            {
                DateTime? previousDate = null;
                @foreach (var message in Messages)
                {
                    if (ShowDateSeparator && (previousDate == null || previousDate.Value.Date != message.Timestamp.Date))
                    {
                        if (DateSeparatorTemplate != null)
                        {
                            @DateSeparatorTemplate(message.Timestamp)
                        }
                        else
                        {
                            <div class="rz-chat-date-separator">
                                <span>@message.Timestamp.ToString(DateSeparatorFormat, Culture ?? System.Globalization.CultureInfo.CurrentCulture)</span>
                            </div>
                        }
                    }
                    previousDate = message.Timestamp;
                    if (MessageTemplate != null)
                    {
                        @MessageTemplate(message)
                    }
                    else
                    {
                    <div class="rz-chat-message @(message.IsUser ? "rz-chat-message-user" : "rz-chat-message-assistant")" @key="message.Id">
                        <RadzenStack class="rz-chat-message-avatar" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0">
                            @if (message.IsUser)
                            {
                                <span class="rz-chat-avatar-initials" title="@UserAvatarText">@UserAvatarText</span>
                            }
                            else
                            {
                                <span class="rz-chat-avatar-initials" title="@AssistantAvatarText">@AssistantAvatarText</span>
                            }
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Vertical" AlignItems="@(message.IsUser ? AlignItems.End : AlignItems.Start)" Gap="0.25rem" class="rz-chat-message-content">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="@(message.IsUser ? JustifyContent.End : JustifyContent.Start)" Gap="0.5rem" class="rz-chat-message-info">
                                <div class="rz-chat-message-time">
                                    @message.Timestamp.ToString(TimestampFormat, Culture ?? System.Globalization.CultureInfo.CurrentCulture)
                                </div>
                                @if (ShowUsage && !message.IsUser && message.Usage != null)
                                {
                                    <span class="rz-chat-message-usage">@FormatUsage(message)</span>
                                }
                            </RadzenStack>
                            @if (message.Attachments.Count > 0)
                            {
                                <div class="rz-chat-message-attachments">
                                    @foreach (var attachment in message.Attachments)
                                    {
                                        if (attachment.IsImage)
                                        {
                                            <img src="@attachment.Url" alt="@attachment.Name" title="@attachment.Name" class="rz-chat-message-attachment-image" />
                                        }
                                        else
                                        {
                                            <span class="rz-chat-attachment"><RadzenIcon Icon="attach_file" /><span class="rz-chat-attachment-name">@attachment.Name</span></span>
                                        }
                                    }
                                </div>
                            }
                            @if (ShowReasoning && !string.IsNullOrEmpty(message.Reasoning))
                            {
                                <details class="rz-chat-reasoning" open="@(message.IsStreaming && string.IsNullOrEmpty(message.Content))">
                                    <summary class="rz-chat-reasoning-summary">
                                        <RadzenIcon Icon="psychology" class="rz-chat-reasoning-icon" />
                                        <span class="rz-chat-reasoning-title">@Localize(nameof(RadzenStrings.AIChat_Reasoning))</span>
                                        @if (message.IsStreaming && string.IsNullOrEmpty(message.Content))
                                        {
                                            <RadzenIcon Icon="more_horiz" class="rz-chat-message-streaming-icon" />
                                        }
                                        <RadzenIcon Icon="expand_more" class="rz-chat-reasoning-toggle" />
                                    </summary>
                                    <div class="rz-chat-reasoning-content">@message.Reasoning</div>
                                </details>
                            }
                            @if (ShowToolCalls && message.ToolCalls.Count > 0)
                            {
                                <div class="rz-chat-tool-calls">
                                    @foreach (var call in message.ToolCalls)
                                    {
                                        if (ToolCallTemplate != null)
                                        {
                                            @ToolCallTemplate(call)
                                        }
                                        else
                                        {
                                            <details class="rz-chat-tool-call rz-chat-tool-call-@(call.Status.ToString().ToLowerInvariant())" open="@(call.Status == ChatToolCallStatus.AwaitingApproval)">
                                                <summary class="rz-chat-tool-call-summary">
                                                    <RadzenIcon Icon="@GetToolCallIcon(call)" class="rz-chat-tool-call-icon" />
                                                    <span class="rz-chat-tool-call-name">@call.Name</span>
                                                    @if (call.Arguments != null && call.Arguments.Count > 0)
                                                    {
                                                        <span class="rz-chat-tool-call-arguments">@call.FormattedArguments</span>
                                                    }
                                                    <span class="rz-chat-tool-call-status">@GetToolCallStatusText(call)</span>
                                                    <RadzenIcon Icon="expand_more" class="rz-chat-tool-call-toggle" />
                                                </summary>
                                                <div class="rz-chat-tool-call-details">
                                                    @if (call.Status == ChatToolCallStatus.AwaitingApproval)
                                                    {
                                                        <div class="rz-chat-tool-approval">
                                                            <span>@string.Format(Culture ?? System.Globalization.CultureInfo.CurrentCulture, Localize(nameof(RadzenStrings.AIChat_ToolApprovalMessage)), call.Name)</span>
                                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                                                <RadzenButton Text="@Localize(nameof(RadzenStrings.AIChat_ApproveText))" Icon="check" Size="ButtonSize.Small" Disabled="@(IsLoading || Disabled)" Click="@(() => ApproveToolCall(call))" class="rz-chat-tool-approve" />
                                                                <RadzenButton Text="@Localize(nameof(RadzenStrings.AIChat_RejectText))" Icon="close" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Disabled="@(IsLoading || Disabled)" Click="@(() => RejectToolCall(call))" class="rz-chat-tool-reject" />
                                                            </RadzenStack>
                                                        </div>
                                                    }
                                                    @if (call.Arguments != null && call.Arguments.Count > 0)
                                                    {
                                                        <div class="rz-chat-tool-call-section">
                                                            <span class="rz-chat-tool-call-label">@Localize(nameof(RadzenStrings.AIChat_ToolCallArguments))</span>
                                                            <pre class="rz-chat-tool-call-code">@call.FormattedArgumentsJson</pre>
                                                        </div>
                                                    }
                                                    @if (call.Exception != null)
                                                    {
                                                        <div class="rz-chat-tool-call-section">
                                                            <span class="rz-chat-tool-call-label">@Localize(nameof(RadzenStrings.AIChat_ToolCallFailed))</span>
                                                            <pre class="rz-chat-tool-call-code">@call.Exception.Message</pre>
                                                        </div>
                                                    }
                                                    else if (call.Result != null)
                                                    {
                                                        <div class="rz-chat-tool-call-section">
                                                            <span class="rz-chat-tool-call-label">@Localize(nameof(RadzenStrings.AIChat_ToolCallResult))</span>
                                                            <pre class="rz-chat-tool-call-code">@call.FormattedResult</pre>
                                                        </div>
                                                    }
                                                </div>
                                            </details>
                                        }
                                    }
                                </div>
                            }
                            @if (message.IsStreaming || !string.IsNullOrEmpty(message.Content))
                            {
                                <div class="rz-chat-message-text">
                                    @if (message.IsStreaming)
                                    {
                                        @message.Content <RadzenIcon Icon="more_horiz" class="rz-chat-message-streaming-icon" />
                                    }
                                    else
                                    {
                                        <RadzenMarkdown Text=@message.Content />
                                    }
                                </div>
                            }
                            @if (ShowCitations && message.Citations.Count > 0)
                            {
                                <div class="rz-chat-citations">
                                    <span class="rz-chat-citations-label">@Localize(nameof(RadzenStrings.AIChat_Sources))</span>
                                    @for (var index = 0; index < message.Citations.Count; index++)
                                    {
                                        var citation = message.Citations[index];
                                        if (CitationTemplate != null)
                                        {
                                            @CitationTemplate(citation)
                                        }
                                        else if (!string.IsNullOrEmpty(citation.Url))
                                        {
                                            <a class="rz-chat-citation" href="@citation.Url" target="_blank" rel="noopener noreferrer" title="@(citation.Snippet ?? citation.Url)">
                                                <span class="rz-chat-citation-index">@(index + 1)</span>
                                                <span class="rz-chat-citation-title">@(string.IsNullOrEmpty(citation.Title) ? citation.Url : citation.Title)</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="rz-chat-citation" title="@citation.Snippet">
                                                <span class="rz-chat-citation-index">@(index + 1)</span>
                                                <span class="rz-chat-citation-title">@(citation.Title ?? citation.FileId)</span>
                                            </span>
                                        }
                                    }
                                </div>
                            }
                        </RadzenStack>
                    </div>
                    }
                }
            }
        </div>

        <!-- Chat Input -->
        <div class="rz-chat-input">
            @if (pendingAttachments.Count > 0)
            {
                <div class="rz-chat-attachments">
                    @foreach (var attachment in pendingAttachments)
                    {
                        <span class="rz-chat-attachment" @key="attachment">
                            @if (attachment.IsImage)
                            {
                                <img src="@attachment.Url" alt="@attachment.Name" class="rz-chat-attachment-thumb" />
                            }
                            else
                            {
                                <RadzenIcon Icon="attach_file" />
                            }
                            <span class="rz-chat-attachment-name" title="@attachment.Name">@attachment.Name</span>
                            <RadzenButton Icon="close" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Title="@Localize(nameof(RadzenStrings.AIChat_RemoveAttachmentTitle))" Disabled="@(Disabled || IsLoading)" Click="@(() => RemoveAttachment(attachment))" class="rz-chat-attachment-remove" />
                        </span>
                    }
                </div>
            }
            <div class="rz-chat-input-inner">
                <textarea @ref="inputElement" 
                          value="@CurrentInput"
                          @oninput="OnInput" 
                          @onkeydown="OnKeyDown" 
                          @onkeydown:preventDefault="preventDefault"
                          class="rz-textarea rz-chat-textarea"
                          placeholder="@Placeholder"
                          disabled="@Disabled"
                          readonly="@ReadOnly"
                          rows="1"
                          @attributes="@InputAttributes"></textarea>
                <div class="rz-chat-input-actions">
                    @if (AllowAttachments)
                    {
                        <InputFile id="@attachInputId" OnChange="@OnFilesSelected" multiple accept="@AcceptedAttachmentTypes" style="display: none" />
                        <RadzenButton Icon="attach_file"
                                      ButtonStyle="ButtonStyle.Base"
                                      Variant="Variant.Text"
                                      Disabled="@(IsLoading || Disabled || ReadOnly)"
                                      Click="@OnAttachClick"
                                      Title="@Localize(nameof(RadzenStrings.AIChat_AttachTitle))"
                                      class="rz-chat-attach-btn" />
                    }
                    @if (IsLoading)
                    {
                        <RadzenButton Icon="stop_circle"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Variant="Variant.Text"
                                      Click="@Stop"
                                      Title="@Localize(nameof(RadzenStrings.AIChat_StopTitle))"
                                      class="rz-chat-stop-btn" />
                    }
                    else
                    {
                        <RadzenButton Icon="send"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Variant="Variant.Text"
                                      Disabled="@((string.IsNullOrWhiteSpace(CurrentInput) && pendingAttachments.Count == 0) || Disabled)"
                                      Click="@OnSendMessage"
                                      Title="@Localize(nameof(RadzenStrings.AIChat_SendTitle))"
                                      class="rz-chat-send-btn" />
                    }
                </div>
            </div>
        </div>
    </div>
}