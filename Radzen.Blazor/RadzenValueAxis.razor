@using Radzen.Blazor.Rendering
@implements IDisposable

@inherits AxisBase
<CascadingValue Value="@this">
  @ChildContent
</CascadingValue>
@code {
    [Parameter]
    public string? Name { get; set; }

    /// <summary>
    /// Specifies how the axis range is determined from the plotted series when <see cref="AxisBase.Min" /> and <see cref="AxisBase.Max" /> are not set;
    /// ignored when <see cref="AxisBase.Logarithmic" /> is <c>true</c>. When all plotted values are equal the axis extends from zero past that value
    /// in every mode.
    /// </summary>
    /// <value>Defaults to <see cref="ValueAxisRange.Auto" />.</value>
    [Parameter]
    public ValueAxisRange Range { get; set; } = ValueAxisRange.Auto;

    /// <inheritdoc />
    protected override bool ShouldRefreshChart(ParameterView parameters)
    {
        return base.ShouldRefreshChart(parameters) || DidParameterChange(parameters, nameof(Range), Range);
    }

    internal double Measure(RadzenChart chart)
    {
        if (chart.ShouldInvertAxes())
        {
            return chart.CategoryAxis.LabelLayout?.Size ?? AxisMeasurer.YAxis(chart.ValueScale, chart.CategoryAxis, chart.CategoryAxis.Title);
        }
        else if (Visible == false)
        {
            return 0;
        }
        else
        {
            return AxisMeasurer.YAxis(chart.ValueScale, this, Title);
        }
    }

    internal double Measure(RadzenChart chart, ScaleBase scale)
    {
        if (Visible == false)
        {
            return 0;
        }

        return AxisMeasurer.YAxis(scale, this, Title);
    }

    internal double MeasureHorizontal(ScaleBase scale)
    {
        if (Visible == false)
        {
            return 0;
        }

        return AxisMeasurer.XAxis(scale, this, Title);
    }

    internal override double Size
    {
        get
        {
            return Chart != null ? Measure(Chart) : 0;
        }
    }

    protected override void Initialize()
    {
        if (Chart != null)
        {
            if (string.IsNullOrEmpty(Name))
            {
                Chart.ValueAxis = this;
            }
            else
            {
                Chart.AddValueAxis(Name, this);
            }
        }
    }

    public void Dispose()
    {
        if (Chart != null && !string.IsNullOrEmpty(Name))
        {
            Chart.RemoveValueAxis(Name);
        }
    }
}
