@inherits RadzenComponent
@if (Visible)
{
<span @ref="@Element"
      style="@Style"
      @attributes="Attributes"
      class="@GetCssClass()"
      id="@GetId()"
      role="@(ChipList != null ? null : "button")"
      tabindex="@(ChipList != null ? null : (int?)TabIndexValue)"
      aria-disabled="@(ChipList != null ? null : Disabled ? "true" : "false")"
      @onclick="@OnClick"
      @onkeydown="@OnKeyDown">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <i class="notranslate rzi rz-chip-icon" aria-hidden="true">@Icon</i>
    }

    <span class="rz-chip-text" @onkeydown:stopPropagation>
        @if (ChildContent != null)
        {
            @ChildContent
        }
        else
        {
            @Text
        }
    </span>

    @if (Close.HasDelegate)
    {
        <span class="rz-button rz-button-xs rz-variant-text rz-base rz-shade-lighter rz-button-icon-only rz-chip-remove"
              title="@RemoveChipTitle"
              aria-hidden="true"
              @onclick="@OnCloseClick"
              @onclick:stopPropagation>
            <span class="rz-button-box"><i class="notranslate rz-button-icon-left rzi">close</i></span>
        </span>
    }
</span>
}
