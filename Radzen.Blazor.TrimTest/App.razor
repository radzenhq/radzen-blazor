@using Radzen
@using Radzen.Blazor
@using Radzen.Blazor.TrimTest.Models
@using Radzen.Documents.Spreadsheet
@inject DialogService DialogService

<RadzenComponents />

<div id="trim-status">@status</div>

<ErrorBoundary>
    <ChildContent>
        <RadzenDataGrid TItem="Order" Data="@orders" AllowSorting="true" AllowFiltering="true" AllowGrouping="true">
            <Columns>
                <RadzenDataGridColumn TItem="Order" Property="CustomerName" Title="Customer" />
                <RadzenDataGridColumn TItem="Order" Property="Total" Title="Total" />
                <RadzenDataGridColumn TItem="Order" Property="Status" Title="Status" />
                <RadzenDataGridColumn TItem="Order" Property="Priority" Title="Priority" />
            </Columns>
        </RadzenDataGrid>

        <RadzenDropDown id="value-dropdown" TValue="string" Data="@(new[] { "A", "B", "C" })" @bind-Value="@selectedText" AllowFiltering="true" />

        <RadzenDropDown id="item-dropdown" TValue="int" Data="@dropDownItems" TextProperty="Text" ValueProperty="Value" @bind-Value="@selectedItem" />

        <RadzenScheduler TItem="Appt" Data="@appts" StartProperty="Start" EndProperty="End" TextProperty="Text">
            <RadzenMonthView />
        </RadzenScheduler>

        <RadzenUpload Url="upload" Multiple="true" />

        <RadzenChart id="chart" Style="height: 200px">
            <RadzenColumnSeries TItem="ChartPoint" Data="@points" CategoryProperty="Category" ValueProperty="Value" />
        </RadzenChart>

        <RadzenHtmlEditor id="editor" @bind-Value="@html" Style="height: 200px" />

        <RadzenSpreadsheet id="spreadsheet" Workbook="@workbook" Style="height: 300px" />

        <RadzenButton id="confirm" Text="Confirm" Click="@OpenConfirmAsync" />
        <RadzenButton id="side-dialog" Text="Side dialog" Click="@OpenSideDialog" />
    </ChildContent>
    <ErrorContent Context="ex">
        <div>@SetError(ex)</div>
    </ErrorContent>
</ErrorBoundary>

@code {
    string status = "running";
    string? selectedText;
    int selectedItem = 1;
    string html = "<p>Trimmed editor</p>";

    Order[] orders =
    [
        new() { CustomerName = "Alice", Total = 42, Status = OrderStatus.New,        Customer = new() { City = "Sofia" } },
        new() { CustomerName = "Bob",   Total = 87, Status = OrderStatus.Shipped,    Customer = new() { City = "Varna" } },
        new() { CustomerName = "Carol", Total = 15, Status = OrderStatus.Processing, Customer = new() { City = "Sofia" } },
    ];
    Appt[] appts = [new() { Start = new DateTime(2026, 1, 1), End = new DateTime(2026, 1, 2), Text = "Kickoff" }];
    DropDownItem<int>[] dropDownItems = [new() { Text = "One", Value = 1 }, new() { Text = "Two", Value = 2 }];
    ChartPoint[] points = [new() { Category = "Q1", Value = 10 }, new() { Category = "Q2", Value = 20 }];
    Workbook workbook = CreateWorkbook();

    static Workbook CreateWorkbook()
    {
        var workbook = new Workbook();
        workbook.AddSheet("Sheet1", 20, 8);
        return workbook;
    }

    Task OpenConfirmAsync() => DialogService.Confirm("Trimmed confirm", "Confirm", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No", CloseDialogOnEsc = true });

    void OpenSideDialog() => DialogService.OpenSide<RadzenCard>("Side", options: new SideDialogOptions { CloseDialogOnOverlayClick = true, ShowMask = true });

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return Task.CompletedTask;

        try
        {
            var filters = new List<FilterDescriptor>
            {
                new() { Property = "CustomerName", FilterValue = "A", FilterOperator = FilterOperator.Contains },
                new() { Property = "Total", FilterValue = 10.0, FilterOperator = FilterOperator.GreaterThan },
            };
            _ = orders.AsQueryable()
                .Where(filters, LogicalFilterOperator.And, FilterCaseSensitivity.CaseInsensitive)
                .ToList();
            _ = orders.AsQueryable().GroupByMany(new[] { "Status" }).ToList();
            status = "done";
        }
        catch (Exception ex)
        {
            var root = ex.GetBaseException();
            status = $"error:{root.GetType().Name}: {root.Message}";
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    string SetError(Exception ex)
    {
        status = $"error:{ex.GetType().Name}: {ex.Message}";
        return status;
    }
}
