@inject HttpClient Http
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div id="@containerId" class="@(Plain ? "" : "rz-card rz-variant-filled")" style="@(Plain ? "" : "--rz-card-padding: 0;")">
    <RadzenRow AlignItems="AlignItems.Center" Gap="0" RowGap="1rem">
        @if (ShowHeader)
        {
            <RadzenColumn Size="12" SizeMD="6" class="@columnClass">
                <RadzenText TextStyle="TextStyle.DisplayH4" TagName="TagName.H2">Radzen Blazor Newsletter</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-m-0" Style="opacity: 0.8">
                    Get an email when new components and releases ship.
                </RadzenText>
            </RadzenColumn>
        }
        <RadzenColumn Size="12" SizeMD="@(ShowHeader ? 6 : 12)" class="@columnClass">
            @if (subscribed)
            {
                <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0">
                    Almost done. Check your inbox and confirm your subscription.
                </RadzenText>
            }
            else
            {
                <RadzenTemplateForm TItem="SubscriptionModel" Data="@model" Submit="@OnSubmit" novalidate class="rz-w-100">
                    <RadzenStack AlignItems="AlignItems.Start" Gap="0.5rem">
                        <RadzenCard Variant="Variant.Outlined" class="rz-w-100" Style="--rz-card-padding: 0.5rem; border-radius: calc(var(--rz-button-border-radius) + var(--rz-card-padding)); max-width: 500px">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                                <RadzenTextBox @bind-Value="@model.Email" Name="Email" Placeholder="Enter your email" aria-label="Email address" Style="border-radius: var(--rz-button-border-radius); flex: 1" />
                                <RadzenButton Text="Subscribe" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" IsBusy="@loading" />
                            </RadzenStack>
                        </RadzenCard>
                        <RadzenRequiredValidator Component="Email" Text="* Email is required." />
                        <RadzenEmailValidator Component="Email" Text="* Provide a valid email address." />
                    </RadzenStack>
                    <altcha-widget challengeurl="https://app.radzen.com/api/newsletter/challenge" auto="onload" disablerefetchonexpire hidefooter hidelogo style="display:none"></altcha-widget>
                </RadzenTemplateForm>
                @if (!string.IsNullOrEmpty(error))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon Variant="Variant.Flat" Size="AlertSize.Small" AllowClose="false" class="rz-mt-2" Style="max-width: 500px">
                        @error
                    </RadzenAlert>
                }
                <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-2 rz-mb-0" Style="opacity: 0.8">
                    We care about your data. Read our <RadzenLink Text="Privacy Policy" Path="https://www.radzen.com/privacy-policy" Target="_blank" />.
                </RadzenText>
            }
        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    string containerId = $"newsletter-{Guid.NewGuid():N}";
    bool subscribed;
    bool loading;
    string error;

    [Parameter] public bool ShowHeader { get; set; } = true;

    [Parameter] public bool Plain { get; set; }

    string columnClass => Plain ? "" : "rz-p-6 rz-p-sm-12";

    SubscriptionModel model = new();

    IJSObjectReference altchaModule;

    class SubscriptionModel
    {
        public string Email { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            altchaModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/js/altcha.min.js");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (altchaModule is not null)
        {
            try { await altchaModule.DisposeAsync(); } catch { }
        }
    }

    async Task OnSubmit()
    {
        error = null;
        loading = true;

        try
        {
            var altchaPayload = await GetAltchaPayload();

            // The page-load challenge can be missing (fetch failed) or expired (long-lived
            // page). Re-solve a fresh one and retry once before reporting an error.
            if (string.IsNullOrEmpty(altchaPayload))
            {
                altchaPayload = await SolveFreshAltcha();
            }

            var response = await Subscribe(altchaPayload);

            if (!response.IsSuccessStatusCode && response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                altchaPayload = await SolveFreshAltcha();

                if (!string.IsNullOrEmpty(altchaPayload))
                {
                    response = await Subscribe(altchaPayload);
                }
            }

            if (response.IsSuccessStatusCode)
            {
                subscribed = true;
            }
            else
            {
                error = await GetErrorMessage(response);
                await ResetAltcha();
            }
        }
        catch
        {
            error = "An error occurred. Please try again.";
            await ResetAltcha();
        }
        finally
        {
            loading = false;
        }
    }

    async Task<HttpResponseMessage> Subscribe(string altchaPayload)
    {
        var request = new HttpRequestMessage(HttpMethod.Post, "https://app.radzen.com/api/newsletter/subscribe");

        if (!string.IsNullOrEmpty(altchaPayload))
        {
            request.Headers.Add("X-Altcha", altchaPayload);
        }
        request.Content = new StringContent(
            System.Text.Json.JsonSerializer.Serialize(new { email = model.Email }),
            System.Text.Encoding.UTF8,
            "application/json");

        return await Http.SendAsync(request);
    }

    async Task<string> GetAltchaPayload()
    {
        return await JSRuntime.InvokeAsync<string>("eval",
            $"document.querySelector('#{containerId} input[name=\"altcha\"]')?.value");
    }

    async Task<string> SolveFreshAltcha()
    {
        await ResetAltcha();

        for (var i = 0; i < 20; i++)
        {
            await Task.Delay(250);

            var payload = await GetAltchaPayload();

            if (!string.IsNullOrEmpty(payload))
            {
                return payload;
            }
        }

        return null;
    }

    // Replace the widget with a fresh clone so it solves a new challenge after a failed attempt.
    async Task ResetAltcha()
    {
        await JSRuntime.InvokeVoidAsync("eval",
            $"(function(){{var e=document.querySelector('#{containerId} altcha-widget');if(e){{var c=e.cloneNode(false);for(var a of e.attributes)c.setAttribute(a.name,a.value);e.parentNode.replaceChild(c,e);}}}})()");
    }

    async Task<string> GetErrorMessage(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadAsStringAsync();
            var json = System.Text.Json.JsonDocument.Parse(body);

            if (json.RootElement.TryGetProperty("message", out var messageProp))
            {
                return messageProp.GetString();
            }
        }
        catch
        {
        }

        return "Subscription failed. Please try again.";
    }
}
