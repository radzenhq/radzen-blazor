@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (!string.IsNullOrEmpty(url))
{
    <iframe src="@url" title="PDF preview" style="width: 100%; height: @Height; border: var(--rz-border-base); border-radius: var(--rz-border-radius); background: var(--rz-base-100)"></iframe>
}

@code {
    [Parameter]
    public byte[] Data { get; set; }

    [Parameter]
    public string Height { get; set; } = "480px";

    string url;
    byte[] shown;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Data != shown)
        {
            shown = Data;
            var previous = url;
            url = Data != null ? await JSRuntime.InvokeAsync<string>("Radzen.createObjectUrl", Data, "application/pdf") : null;
            if (previous != null)
            {
                await JSRuntime.InvokeVoidAsync("Radzen.revokeObjectUrl", previous);
            }
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (url != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("Radzen.revokeObjectUrl", url);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
