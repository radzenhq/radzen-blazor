@page "/ui-blocks-contact"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Contact blocks
</RadzenText>

<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1000px;">
    A contact block gives visitors a way to reach you. Whether it is a form, an email address, or office locations, it turns interest into conversation and makes your business approachable.
</RadzenText>

<RadzenText Anchor="ui-blocks-contact#centered-contact-form" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Centered contact form
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A contact block with a centered heading and a simple message form.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/contact/centered-contact-form" Title="Centered contact form" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

