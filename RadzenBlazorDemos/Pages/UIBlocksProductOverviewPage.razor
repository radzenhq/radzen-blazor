@page "/ui-blocks-product-overview"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Product Overview blocks
</RadzenText>

<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1000px;">
    A product overview block is the product detail page hero: gallery, price, options, and the buy action, optionally followed by description tabs and trust signals.
</RadzenText>

<RadzenText Anchor="ui-blocks-product-overview#split-overview" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Split overview
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A product overview block with gallery to the left and details to the right.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/product-overview/split-overview" Title="Split overview" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-product-overview#overview-with-tabs" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Overview with tabs
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A product overview block followed by description, specifications, and care tabs.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/product-overview/overview-with-tabs" Title="Overview with tabs" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-product-overview#quick-view" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Quick view
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A compact product overview block sized for a dialog or popover.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Light">
                <UIBlock Path="/product-overview/quick-view" Title="Quick view" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-product-overview#overview-with-incentives" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Overview with incentives
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A product overview block followed by a strip of trust signals.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/product-overview/overview-with-incentives" Title="Overview with incentives" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

