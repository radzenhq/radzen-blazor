@page "/ui-blocks-form-layouts"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Form Layout blocks
</RadzenText>

<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1000px;">
    A form layout block arranges labels, fields, and actions into a structure users can complete without thinking. These layouts cover the common cases: stacked, two-column, and settings pages.
</RadzenText>

<RadzenText Anchor="ui-blocks-form-layouts#stacked-form" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Stacked form
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A form layout block with sections, stacked fields, and a right-aligned action bar.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/form-layouts/stacked-form" Title="Stacked form" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

