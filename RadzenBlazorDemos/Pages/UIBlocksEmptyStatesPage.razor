@page "/ui-blocks-empty-states"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Empty State blocks
</RadzenText>

<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1000px;">
    An empty state block fills the space where content will eventually appear. Instead of a blank screen, it explains why nothing is shown and points users to the action that gets them started.
</RadzenText>

<RadzenText Anchor="ui-blocks-empty-states#simple-empty-state" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Simple empty state
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    An empty state block with an icon, a short explanation, and a primary action.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/empty-states/simple-empty-state" Title="Simple empty state" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

