@using System.IO
@using Radzen.Documents
@using Radzen.Documents.Core
@using Radzen.Documents.Pdf
@inject IJSRuntime JSRuntime

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
        <RadzenFormField Text="Report title">
            <RadzenTextBox @bind-Value=@title aria-label="title" Change=@(_ => Generate()) />
        </RadzenFormField>
        <RadzenButton Text="Download PDF" Icon="download" ButtonStyle="ButtonStyle.Secondary" Click=@Download />
    </RadzenStack>
    <PdfPreview Data=@pdf />
</RadzenStack>

@code {
    string title = "Fabrikam Annual Report 2026";
    Document document;
    byte[] pdf;

    protected override void OnInitialized()
    {
        Generate();
    }

    void Generate()
    {
        var accent = Color.FromRgb(25, 118, 210);

        document = new Document();
        document.Info.Title = title;

        var section = document.Sections.Add();
        section.Margins.SetAll(48);
        section.HeaderDistance = 24;
        section.FooterDistance = 24;

        var header = section.Header.Blocks.Add(new Paragraph());
        header.Inlines.Add(title).Font.Color = accent;
        header.Inlines.Add("\tCONFIDENTIAL").Font.Color = Color.FromRgb(160, 160, 160);
        header.TabStops.Add(Unit.FromPoint(499), TabAlignment.Right);

        var rule = section.Header.Blocks.Add(new Container());
        rule.Borders.Bottom.Width = 0.5;
        rule.Borders.Bottom.Color = accent;

        var footerRule = section.Footer.Blocks.Add(new Container());
        footerRule.Borders.Top.Width = 0.5;
        footerRule.Borders.Top.Color = accent;

        var footer = section.Footer.Blocks.Add(new Paragraph { SpacingBefore = 4 });
        footer.Font.Size = 9;
        footer.Font.Color = Color.FromRgb(120, 120, 120);
        footer.Inlines.Add("fabrikam.com");
        footer.Inlines.Add("\tPage ");
        footer.Inlines.Add(new PageNumberField());
        footer.Inlines.Add(" of ");
        footer.Inlines.Add(new PageCountField());
        footer.Inlines.Add("\tFY 2026");
        footer.TabStops.Add(Unit.FromPoint(249.5), TabAlignment.Center);
        footer.TabStops.Add(Unit.FromPoint(499), TabAlignment.Right);

        var chapters = new (string Title, string Body)[]
        {
            ("Overview",
             "Fabrikam closed the fiscal year with revenue growth across all three product lines. The furniture "
             + "division led the expansion, driven by the modular office range introduced in the spring collection. "
             + "Operating margin improved for the fourth consecutive year as the Hamburg plant reached full capacity."),
            ("Operations",
             "Manufacturing output rose while defect rates fell to a record low, a direct result of the automated "
             + "inspection line commissioned in January. Logistics costs remained flat despite higher volumes, "
             + "thanks to the consolidated distribution hub serving central Europe."),
            ("Outlook",
             "The board expects moderate growth next year, with investment focused on sustainable materials and "
             + "the new e-commerce platform. Headcount will grow in engineering and customer service, while "
             + "administrative functions remain unchanged."),
        };
        for (var i = 0; i < chapters.Length; i++)
        {
            section.Blocks.Add(new Paragraph(chapters[i].Title)).Font.Size = 16;
            section.Blocks.Add(new Paragraph(chapters[i].Body) { LineSpacing = 1.35 });
            if (i < chapters.Length - 1)
            {
                section.Blocks.Add(new PageBreak());
            }
        }

        pdf = document.ToPdf();
    }

    async Task Download()
    {
        using var stream = new MemoryStream();
        document.SaveAsPdf(stream);
        stream.Position = 0;
        using var streamRef = new DotNetStreamReference(stream);
        await JSRuntime.InvokeVoidAsync("Radzen.downloadFile", "headers-footers.pdf", streamRef, "application/pdf");
    }
}
