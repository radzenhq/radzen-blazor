@using System.Globalization

<RadzenStack class="rz-p-0 rz-p-md-6 rz-p-lg-12">
    <RadzenCard Variant="Variant.Outlined">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.P" Style="margin: 0;">Selected: @GetDateLabel(start) — @GetDateLabel(end). Drag the navigator or use the mouse wheel over either chart.</RadzenText>
            <RadzenButton Text="Full Year" Click="@(() => { start = 0; end = 1; })" Variant="Variant.Outlined" Size="ButtonSize.Small" />
            <RadzenButton Text="Q4" Click="@(() => { start = 0.75; end = 1; })" Variant="Variant.Outlined" Size="ButtonSize.Small" />
        </RadzenStack>
    </RadzenCard>

    <RadzenChart SyncGroup="navigator" AllowZoom="true" AllowPan="true" ShowScrollbar="false" @bind-ViewStart="@start" @bind-ViewEnd="@end" Style="height: 240px;">
        <RadzenAreaSeries FillMode="FillMode.Gradient" Smooth="true" Data="@data" CategoryProperty="Date" ValueProperty="Revenue" Title="Revenue" Stroke="#1E88E5" Fill="#1E88E5">
            <RadzenMarkers Visible="false" />
        </RadzenAreaSeries>
        <RadzenCategoryAxis FormatString="{0:MMM dd}">
            <RadzenAxisCrosshair Visible="true" />
        </RadzenCategoryAxis>
        <RadzenValueAxis Formatter="@FormatAsUSD">
            <RadzenGridLines Visible="true" LineType="LineType.Dashed" />
        </RadzenValueAxis>
    </RadzenChart>

    <RadzenRangeNavigator @bind-Start="@start" @bind-End="@end" ShowAxis="true" Min="@rangeStart" Max="@rangeEnd" AxisFormatString="{0:MMM}" />

    <RadzenChart SyncGroup="navigator" AllowZoom="true" AllowPan="true" ShowScrollbar="false" @bind-ViewStart="@start" @bind-ViewEnd="@end" Style="height: 240px;">
        <RadzenLineSeries Smooth="true" Data="@data" CategoryProperty="Date" ValueProperty="Orders" Title="Orders" Stroke="#EF5350">
            <RadzenMarkers Visible="false" />
        </RadzenLineSeries>
        <RadzenCategoryAxis FormatString="{0:MMM dd}">
            <RadzenAxisCrosshair Visible="true" />
        </RadzenCategoryAxis>
        <RadzenValueAxis>
            <RadzenGridLines Visible="true" LineType="LineType.Dashed" />
        </RadzenValueAxis>
    </RadzenChart>
</RadzenStack>

@code {
    class DataItem
    {
        public DateTime Date { get; set; }
        public double Revenue { get; set; }
        public double Orders { get; set; }
    }

    double start = 0.5;
    double end = 0.75;
    DateTime rangeStart = new(2025, 1, 1);
    DateTime rangeEnd = new(2025, 12, 31);
    List<DataItem> data = new();

    string FormatAsUSD(object value)
    {
        return ((double)value).ToString("C0", CultureInfo.CreateSpecificCulture("en-US"));
    }

    string GetDateLabel(double fraction)
    {
        var totalDays = (rangeEnd - rangeStart).TotalDays;
        return rangeStart.AddDays(fraction * totalDays).ToString("MMM dd, yyyy");
    }

    protected override void OnInitialized()
    {
        var random = new Random(77);

        for (int i = 0; i < 365; i++)
        {
            var seasonalRevenue = 50000 + 15000 * Math.Sin((i - 60) * Math.PI / 182.5);
            var seasonalOrders = 1200 + 300 * Math.Sin((i - 45) * Math.PI / 182.5);

            data.Add(new DataItem
            {
                Date = rangeStart.AddDays(i),
                Revenue = Math.Round(seasonalRevenue + random.NextDouble() * 10000 - 5000),
                Orders = Math.Round(seasonalOrders + random.NextDouble() * 200 - 100)
            });
        }
    }
}
