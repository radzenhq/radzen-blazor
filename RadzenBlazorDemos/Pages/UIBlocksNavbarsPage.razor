</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A navbar block with a search box and account actions, typical for a storefront. On narrow screens the search takes its own full-width row.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
