@page "/ui-blocks-navbars"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Navbar blocks
</RadzenText>

<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1000px;">
    A navbar block is the website header: brand, navigation links, and the primary call-to-action. Unlike an app shell header, it is built for marketing sites and landing pages. All blocks rearrange responsively: on narrow screens the brand and actions stay on the first row and the navigation reflows below them.
</RadzenText>

<RadzenText Anchor="ui-blocks-navbars#simple-navbar" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Simple navbar
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A navbar block with brand, links, and a call-to-action button. Below the md breakpoint the links move to a second row.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/navbars/simple-navbar" Title="Simple navbar" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

