@using System.IO
@using Radzen.Documents
@using Radzen.Documents.Pdf
@inject IJSRuntime JSRuntime

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
        <RadzenButton Text="Download flattened PDF" Icon="download" ButtonStyle="ButtonStyle.Secondary" Click=@Download />
    </RadzenStack>
    <RadzenText TextStyle="TextStyle.Caption">
        Download both variants and try editing the name in a viewer: the interactive copy still has fields, the flattened copy is permanent page content.
    </RadzenText>
    <RadzenRow>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText TextStyle="TextStyle.Overline">Interactive form</RadzenText>
            <PdfPreview Data=@filled Height="360px" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText TextStyle="TextStyle.Overline">Flattened</RadzenText>
            <PdfPreview Data=@pdf Height="360px" />
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

@code {
    byte[] filled;
    PortableDocument loaded;
    byte[] pdf;

    protected override void OnInitialized()
    {
        Generate();
    }

    void Generate()
    {
        var document = new Document();
        document.Info.Title = "Flattening";
        var section = document.Sections.Add();
        section.Margins.SetAll(48);
        section.Blocks.Add(new Paragraph("Contract")).Font.Size = 16;
        var name = section.Blocks.Add(new Paragraph("Signed by: "));
        name.Inlines.Add(new TextInput("signer") { Width = 220 });
        var agree = section.Blocks.Add(new Paragraph());
        agree.Inlines.Add(new CheckBox("agreed") { Label = "I agree to the terms" });
        agree.Inlines.Add(" I agree to the terms");

        using var source = new MemoryStream(document.ToPdf());
        loaded = PortableDocument.LoadFromStream(source);
        loaded.AcroForm.FillField("signer", "Maya Lindqvist");
        loaded.AcroForm.CheckField("agreed");
        filled = loaded.ToArray();

        loaded.Flatten();
        pdf = loaded.ToArray();
    }

    async Task Download()
    {
        using var stream = new MemoryStream();
        loaded.SaveToStream(stream);
        stream.Position = 0;
        using var streamRef = new DotNetStreamReference(stream);
        await JSRuntime.InvokeVoidAsync("Radzen.downloadFile", "flattened.pdf", streamRef, "application/pdf");
    }
}
