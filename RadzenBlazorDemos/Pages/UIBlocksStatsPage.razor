@page "/ui-blocks-stats"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Stats blocks
</RadzenText>

<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1000px;">
    A stats block presents key numbers such as customers, downloads, or uptime in a prominent, easy-to-scan section. It builds credibility by backing the message of the page with measurable results.
</RadzenText>

<RadzenText Anchor="ui-blocks-stats#centered-stats" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Centered stats
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A stats block with a centered heading and a row of large numbers.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/stats/centered-stats" Title="Centered stats" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

