@page "/ui-blocks-bento"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Bento Grid blocks
</RadzenText>

<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1000px;">
    A bento grid block arranges features in a mosaic of differently sized tiles, giving a product overview visual rhythm and letting the most important capability take the biggest cell.
</RadzenText>

<RadzenText Anchor="ui-blocks-bento#feature-bento" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Feature bento
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A bento block with one large feature tile and supporting tiles around it.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/bento/feature-bento" Title="Feature bento" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-bento#bento-with-stats" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Bento with stats
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A bento block mixing feature tiles with large stat tiles.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Light">
                <UIBlock Path="/bento/bento-with-stats" Title="Bento with stats" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-bento#bento-with-images" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Bento with images
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A bento block where tiles combine photography with short captions.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/bento/bento-with-images" Title="Bento with images" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-bento#dark-bento" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Outlined bento
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A bento block on a dark background with outlined tiles.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Dark">
                <UIBlock Path="/bento/dark-bento" Title="Outlined bento" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>
