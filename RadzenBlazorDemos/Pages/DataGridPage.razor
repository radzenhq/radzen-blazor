@page "/datagrid"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Blazor DataGrid
</RadzenText>
<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1200px;">
    The Radzen Blazor DataGrid displays tabular data with sorting, filtering, paging, grouping, and editing built in. Bind it to IQueryable and Entity Framework, an OData service, a DataTable, or dynamic data, and it pages, sorts, and filters on the server.
</RadzenText>

<RadzenText Anchor="datagrid#whats-included" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-4 rz-pb-2">
    What's included
</RadzenText>
<ul class="datagrid-included rz-mb-4">
    @foreach (var item in included)
    {
        <li>
            @item.Text:
            @for (var i = 0; i < item.Links.Length; i++)
            {
                var link = item.Links[i];
                @(i > 0 ? ", " : " ")<RadzenLink Path="@link.Path" Text="@link.Text" />
            }
        </li>
    }
</ul>
<RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" class="datagrid-included-more rz-mb-8">
    See <RadzenLink Path="https://www.radzen.com/blog/radzendatagrid-vs-muddatagrid-vs-quickgrid" Text="how our DataGrid compares to other open-source data grids" />.
</RadzenText>

<RadzenExample ComponentName="DataGrid" Example="DataGridIQueryable">
    <DataGridIQueryable />
</RadzenExample>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H2" class="rz-pt-12 rz-pb-4">
    DataGrid features
</RadzenText>
<RadzenRow Gap="1rem" RowGap="1rem" class="datagrid-features">
    @foreach (var feature in features)
    {
        <RadzenColumn Size="12" SizeSM="6" SizeMD="4">
            <RadzenLink Path="@feature.Path">
                <RadzenCard Variant="Variant.Outlined" class="rz-h-100">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3" class="rz-mb-1">@feature.Title</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" class="rz-mb-0 rz-color-text-secondary">@feature.Description</RadzenText>
                </RadzenCard>
            </RadzenLink>
        </RadzenColumn>
    }
</RadzenRow>

<style>
    .datagrid-included {
        max-width: 1200px;
        margin-block-start: 0;
        padding-inline-start: 1.25rem;
        columns: 2 24rem;
        column-gap: 2rem;
        line-height: 1.75;
    }

    .datagrid-included .rz-link,
    .datagrid-included-more .rz-link {
        --rz-link-text-decoration: underline;
    }

    .datagrid-features .rz-link {
        --rz-link-text-decoration: none;
        --rz-link-hover-text-decoration: none;
        color: inherit;
        display: block;
        transition: transform 0.15s;
    }

    .datagrid-features .rz-link:hover {
        transform: translateY(-2px);
    }

    .datagrid-features .rz-link:hover .rz-card {
        box-shadow: var(--rz-shadow-2);
    }
</style>

<RadzenText Anchor="datagrid#keyboard-navigation" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Keyboard Navigation
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    The following keys or key combinations provide a way for users to navigate and interact with Radzen Blazor DataGrid component.
</RadzenText>

<KeyboardNavigationDataGrid Data="@data" />

@code {
    (string Text, (string Text, string Path)[] Links)[] included = new[]
    {
        ("Data binding", new[] { ("IQueryable and EF Core", "/datagrid-iqueryable"), ("OData", "/datagrid-odata"), ("LoadData", "/datagrid-loaddata") }),
        ("Virtualization", new[] { ("rows", "/datagrid-virtualization"), ("columns", "/datagrid-column-virtualization") }),
        ("Columns", new[] { ("frozen columns", "/datagrid-frozen-columns"), ("column picker", "/datagrid-column-picker") }),
        ("Export in the browser", new[] { ("Excel and CSV", "/datagrid-export") }),
        ("Grouping and aggregates", new[] { ("grouping", "/datagrid-grouping-api"), ("footer totals", "/datagrid-footer-totals") }),
        ("Editing", new[] { ("inline", "/datagrid-inline-edit"), ("in-cell", "/datagrid-incell-edit") }),
        ("Filtering", new[] { ("Excel-like filtering", "/datagrid-checkboxlist-filter"), ("advanced filter", "/datagrid-advanced-filter") }),
        ("Hierarchy", new[] { ("master/detail and hierarchy", "/master-detail-hierarchy") }),
        ("Grid state", new[] { ("save and restore settings", "/datagrid-save-settings") }),
        ("AI", new[] { ("AI assistant", "/datagrid-ai-assistant") }),
        ("Accessibility", new[] { ("keyboard navigation", "/datagrid-keyboard-navigation") }),
    };

    (string Title, string Description, string Path)[] features = new[]
    {
        ("Data binding", "IQueryable & Entity Framework, OData, DataTable, dynamic data, or custom via LoadData", "/datagrid-iqueryable"),
        ("Filtering", "Simple and advanced filter modes, plus Excel-style checkbox filtering", "/datagrid-advanced-filter"),
        ("Sorting", "Single and multi-column sorting, with custom comparers", "/datagrid-sort"),
        ("Paging", "Built-in pager with configurable position and page sizes", "/datagrid-pager-position"),
        ("Grouping", "Group by one or more columns, with header and footer aggregates", "/datagrid-grouping-api"),
        ("Virtualization", "Render thousands of rows smoothly by loading only what's visible", "/datagrid-virtualization"),
        ("Editing", "Inline and in-cell editing with validation", "/datagrid-inline-edit"),
        ("Columns", "Templates, resizing, reordering, frozen columns, and a column picker", "/datagrid-column-template"),
        ("Selection", "Single, multiple, and cell selection", "/datagrid-multiple-selection"),
        ("Excel & CSV export", "Export grid data to Excel and CSV in the browser", "/datagrid-export"),
        ("Hierarchy", "Master-detail and self-referencing hierarchies", "/master-detail-hierarchy"),
        ("State persistence", "Save and restore column, sort, filter, and paging settings", "/datagrid-save-settings"),
    };

    List<KeyboardShortcut> data = DataGridKeyboardNavigationPage.Shortcuts;
}
