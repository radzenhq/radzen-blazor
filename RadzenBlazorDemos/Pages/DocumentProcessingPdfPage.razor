@page "/document-processing-pdf"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Blazor <strong>PDF</strong>
</RadzenText>
<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4">
    Create PDF documents in Blazor and C#. The document engine is pure managed code with no native dependencies, so every demo on these pages runs entirely in your browser - the PDF is generated, displayed, and downloaded without touching a server.
</RadzenText>

<RadzenText Anchor="document-processing-pdf#hello-world" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-8">
