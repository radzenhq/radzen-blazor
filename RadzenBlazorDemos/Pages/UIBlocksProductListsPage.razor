@page "/ui-blocks-product-lists"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Product List blocks
</RadzenText>

<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1000px;">
    A product list block arranges many items for browsing: grids with sorting, compact rows, and collection tiles that lead into a category.
</RadzenText>

<RadzenText Anchor="ui-blocks-product-lists#grid-with-toolbar" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Grid with toolbar
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A product list block with a result count and sort control above the grid.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/product-lists/grid-with-toolbar" Title="Grid with toolbar" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

