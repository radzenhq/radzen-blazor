@page "/ui-blocks-banners"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Banner blocks
</RadzenText>

<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1000px;">
    A banner block delivers a short, site-wide message: an announcement, a promotion, or a required notice. Good banners are compact, dismissible, and impossible to misread.
</RadzenText>

<RadzenText Anchor="ui-blocks-banners#announcement-bar" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Announcement bar
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A slim top-of-page banner with a message, a link, and a dismiss button.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Primary">
                <UIBlock Path="/banners/announcement-bar" Title="Announcement bar" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-banners#promo-banner" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Promo banner
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A promotional banner with a badge, message, and call-to-action button.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Dark">
                <UIBlock Path="/banners/promo-banner" Title="Promo banner" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

