<RadzenStack Gap="0.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenSpeechToTextButton Change="@OnSpeech" Title="Ask by voice" />
        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.Span" class="rz-color-secondary">@(string.IsNullOrEmpty(lastTranscript) ? "Click the microphone and ask a question" : $"Heard: {lastTranscript}")</RadzenText>
    </RadzenStack>
    <RadzenAIChat @ref="chat" Title="Voice assistant" Placeholder="Type or use the microphone..." Style="height: 420px" />
</RadzenStack>

@code {
    RadzenAIChat chat;
    string lastTranscript;

    async Task OnSpeech(string transcript)
    {
        if (string.IsNullOrWhiteSpace(transcript))
        {
            return;
        }

        lastTranscript = transcript;
        await chat.SendMessage(transcript);
    }
}
