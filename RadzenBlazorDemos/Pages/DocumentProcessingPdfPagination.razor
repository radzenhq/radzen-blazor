@using System.IO
@using Radzen.Documents
@using Radzen.Documents.Pdf
@inject IJSRuntime JSRuntime

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
        <RadzenCheckBox @bind-Value=@keepTogether Name="keep" aria-label="keep together" Change=@((bool _) => Generate()) />
        <RadzenLabel Text="Keep the conclusion together" Component="keep" />
        <RadzenCheckBox @bind-Value=@keepWithNext Name="next" aria-label="keep with next" Change=@((bool _) => Generate()) />
        <RadzenLabel Text="Keep headings with their text" Component="next" />
        <RadzenButton Text="Download PDF" Icon="download" ButtonStyle="ButtonStyle.Secondary" Click=@Download />
    </RadzenStack>
    <PdfPreview Data=@pdf />
</RadzenStack>

@code {
    bool keepTogether = true;
    bool keepWithNext = true;
    Document document;
    byte[] pdf;

    static readonly string[] Chapters =
    {
        "When movable type reached Europe, compositors discovered a problem the scribes never had: a page ends "
            + "wherever the metal runs out, not where the thought does. The first rule they wrote down survives in "
            + "every layout engine since - never leave the opening line of a paragraph stranded at the foot of a page.",
        "The vocabulary is grim for a reason. A widow is a closing line abandoned at the top of a page, an orphan an "
            + "opening line left behind at the bottom; both cost the reader a beat of confusion that good composition "
            + "spends elsewhere. Printers fought them with tracking, rewriting, and when all else failed, a wider margin.",
        "Headings raise the stakes. A chapter title at the very bottom of a page promises content the page cannot "
            + "deliver, so the binding between a heading and its first paragraph became a rule of its own - keep with "
            + "next - enforced here exactly as a hot-metal compositor would have.",
        "Some content refuses to break at all. A signature block split across pages invites forgery disputes; a table "
            + "of figures split mid-row invites misreading. Keep-together marks such blocks, and the engine moves them "
            + "whole to the next page rather than divide them.",
    };

    protected override void OnInitialized()
    {
        Generate();
    }

    void Generate()
    {
        document = new Document();
        document.Info.Title = "Pagination control";

        var heading = document.Styles.Add("Heading");
        heading.Font.Size = 14;
        heading.Font.Bold = true;
        heading.SpacingBefore = 12;

        var section = document.Sections.Add();
        section.Margins.SetAll(40);

        var footer = section.Footer.Blocks.Add(new Paragraph());
        footer.Alignment = HorizontalAlignment.Center;
        footer.Inlines.Add("Page ");
        footer.Inlines.Add(new PageNumberField());
        footer.Inlines.Add(" of ");
        footer.Inlines.Add(new PageCountField());

        var titles = new[]
        {
            "1. Where pages end", "2. Widows and orphans", "3. Headings that keep their word",
            "4. Blocks that will not break", "5. The compositor's ledger", "6. Rules become software",
        };
        for (var i = 0; i < titles.Length; i++)
        {
            var title = section.Blocks.Add(new Paragraph(titles[i]) { StyleName = "Heading" });
            title.KeepWithNext = keepWithNext;
            section.Blocks.Add(new Paragraph(Chapters[i % Chapters.Length] + " " + Chapters[(i + 1) % Chapters.Length])
            {
                Widows = 2,
                Orphans = 2,
            });
        }

        section.Blocks.Add(new Paragraph("In closing") { StyleName = "Heading" });
        var conclusion = section.Blocks.Add(new Paragraph(string.Join(" ", Chapters)));
        conclusion.KeepTogether = keepTogether;

        pdf = document.ToPdf();
    }

    async Task Download()
    {
        using var stream = new MemoryStream();
        document.SaveAsPdf(stream);
        stream.Position = 0;
        using var streamRef = new DotNetStreamReference(stream);
        await JSRuntime.InvokeVoidAsync("Radzen.downloadFile", "pagination.pdf", streamRef, "application/pdf");
    }
}
