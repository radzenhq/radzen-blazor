@page "/ui-blocks-error-pages"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Error Page blocks
</RadzenText>

<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1000px;">
    An error page block turns a dead end into a helpful moment. Clear wording, a way back, and a support option keep users moving when something goes wrong.
</RadzenText>

<RadzenText Anchor="ui-blocks-error-pages#not-found-centered" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    404 centered
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A not-found block with a large status code and a way back home.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/error-pages/not-found-centered" Title="404 centered" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-error-pages#not-found-with-image" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    404 with image
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A not-found block with content to the left and a full-height image to the right.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Light">
                <UIBlock Path="/error-pages/not-found-with-image" Title="404 with image" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-error-pages#not-found-with-links" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    404 with helpful links
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A not-found block that lists popular destinations to keep visitors on the site.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/error-pages/not-found-with-links" Title="404 with helpful links" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-error-pages#server-error" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    500 error
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A server error block with a retry action and a support link.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Dark">
                <UIBlock Path="/error-pages/server-error" Title="500 error" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-error-pages#maintenance" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Maintenance
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
