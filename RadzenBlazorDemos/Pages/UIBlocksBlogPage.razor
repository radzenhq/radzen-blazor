@page "/ui-blocks-blog"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Blog blocks
</RadzenText>

<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1000px;">
    A blog block highlights articles and news on a landing or overview page. Cards with a cover image, category, title, and excerpt invite visitors to keep reading and coming back.
</RadzenText>

<RadzenText Anchor="ui-blocks-blog#article-cards" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Article cards
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A blog block with a grid of article cards.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/blog/article-cards" Title="Article cards" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

