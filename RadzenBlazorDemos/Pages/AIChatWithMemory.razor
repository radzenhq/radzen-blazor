@using Radzen.Blazor
@using Radzen
@inherits ComponentBase
@inject IAIChatService ChatService
@inject NavigationManager NavigationManager

<RadzenRow Gap="1rem">
    <RadzenColumn Size="12" SizeLG="7">
        @if (currentSessionId != null)
        {
            <RadzenAIChat @key="@currentSessionId"
                          Title="AI Assistant with Memory"
                          Placeholder="Ask me anything... I'll remember our conversation, even after a reload."
                          SessionId="@currentSessionId"
                          UserId="@UserId"
                          ResponseReceived="@OnResponseReceived"
                          ChatCleared="@OnChatCleared"
                          ShowClearButton="true"
                          Style="height: 520px" />
        }
    </RadzenColumn>
    <RadzenColumn Size="12" SizeLG="5">
        <RadzenStack Gap="1rem">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="0.75rem">
                    <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-m-0">Current conversation</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-text-secondary-color" Style="word-break: break-all">@currentSessionId</RadzenText>
                    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.5rem">
                        <RadzenButton Text="New conversation" Icon="add" Click="@OnNewSession" />
                        <RadzenButton Text="Reload page" Icon="refresh" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@ReloadPage" />
                        <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@OnDeleteSession" Disabled="@(currentSessionId == null)" />
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0 rz-text-secondary-color">
                        The conversation is saved to the store after every answer. Reload the page or open another conversation and come back: the messages, tool calls and attachments are restored.
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="0.5rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-m-0">Saved conversations</RadzenText>
                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Shade="Shade.Lighter" Text="@($"{sessions.Count} saved, {sessions.Sum(s => s.Messages.Count)} messages")" />
                    </RadzenStack>
                    @if (sessions.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0 rz-text-secondary-color">No conversations yet. Send a message to start one.</RadzenText>
                    }
                    <RadzenStack Gap="0.25rem" Style="max-height: 300px; overflow: auto;">
                        @foreach (var session in sessions)
                        {
                            <RadzenButton Variant="@(session.Id == currentSessionId ? Variant.Flat : Variant.Text)" ButtonStyle="@(session.Id == currentSessionId ? ButtonStyle.Primary : ButtonStyle.Base)" Shade="@(session.Id == currentSessionId ? Shade.Lighter : Shade.Default)"
                                          Click="@(() => OnOpenSession(session.Id))" Style="justify-content: flex-start; text-align: start; width: 100%;">
                                <RadzenStack Gap="0" AlignItems="AlignItems.Start">
                                    <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.Span" class="rz-m-0" Style="font-weight: 600;">@(string.IsNullOrEmpty(session.Title) ? "Empty conversation" : session.Title)</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Span" class="rz-m-0 rz-text-secondary-color">@session.Messages.Count messages · @session.LastUpdated.ToString("g")</RadzenText>
                                </RadzenStack>
                            </RadzenButton>
                        }
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenStack>
    </RadzenColumn>
</RadzenRow>

@code {
    const string UserId = "demo-user";

    string currentSessionId;
    IReadOnlyList<ConversationSession> sessions = new List<ConversationSession>();

    protected override async Task OnInitializedAsync()
    {
        var query = new Uri(NavigationManager.Uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(pair => pair.Split('=', 2))
            .FirstOrDefault(pair => pair[0] == "session" && pair.Length == 2);

        currentSessionId = query != null && !string.IsNullOrEmpty(query[1]) ? Uri.UnescapeDataString(query[1]) : Guid.NewGuid().ToString();

        await RefreshSessions();
    }

    async Task OnResponseReceived(string response) => await RefreshSessions();

    async Task OnChatCleared() => await RefreshSessions();

    async Task OnNewSession()
    {
        currentSessionId = Guid.NewGuid().ToString();
        await RefreshSessions();
    }

    async Task OnOpenSession(string sessionId)
    {
        currentSessionId = sessionId;
        await RefreshSessions();
    }

    async Task OnDeleteSession()
    {
        await ChatService.DeleteSessionAsync(currentSessionId);
        currentSessionId = Guid.NewGuid().ToString();
        await RefreshSessions();
    }

    void ReloadPage()
    {
        var uri = new Uri(NavigationManager.Uri);
        NavigationManager.NavigateTo($"{uri.GetLeftPart(UriPartial.Path)}?session={Uri.EscapeDataString(currentSessionId)}#memory", forceLoad: true);
    }

    async Task RefreshSessions()
    {
        sessions = await ChatService.GetSessionsAsync(UserId);
    }
}
