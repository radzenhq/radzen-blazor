@page "/ui-blocks-text-and-media"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Text & Media blocks
</RadzenText>

<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1000px;">
    A text and media block presents longer-form text such as about pages, product stories, or documentation intros in a comfortable, readable layout, optionally paired with supporting imagery.
</RadzenText>

