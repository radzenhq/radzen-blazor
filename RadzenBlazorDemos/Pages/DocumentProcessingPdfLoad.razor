@using System.IO
@using Radzen.Documents
@using Radzen.Documents.Pdf

<RadzenStack Gap="1rem">
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" AllowClose="false" class="rz-m-0" Size="AlertSize.Small">
        @status
    </RadzenAlert>
    <PdfPreview Data=@pdf />
</RadzenStack>

@code {
    byte[] pdf;
    string status;

    protected override void OnInitialized()
    {
        var document = new Document();
        document.Info.Title = "Fabrikam Quarterly Report";
        document.Info.Author = "Fabrikam, Inc.";
        var section = document.Sections.Add();
        section.Margins.SetAll(48);
        foreach (var (quarter, revenue, note) in new[]
        {
            ("Q1", "1.24M EUR", "Desk revenue carried the quarter; the Hamburg showroom opened in March."),
            ("Q2", "1.41M EUR", "Seating overtook desks for the first time on the strength of the conference line."),
            ("Q3", "1.58M EUR", "Acoustic panels doubled quarter over quarter after the open-office study."),
        })
        {
            section.Blocks.Add(new Paragraph($"{quarter} - {revenue}")).Font.Size = 16;
            section.Blocks.Add(new Paragraph(note));
            if (quarter != "Q3")
            {
                section.Blocks.Add(new PageBreak());
            }
        }

        pdf = document.ToPdf();

        using var source = new MemoryStream(pdf);
        var loaded = PortableDocument.LoadFromStream(source);
        status = $"Loaded '{loaded.Info.Title}' by {loaded.Info.Author}: {loaded.Pages.Count} pages, "
            + $"first page {loaded.Pages[0].MediaBox.Width:F0}x{loaded.Pages[0].MediaBox.Height:F0}pt.";
    }
}
