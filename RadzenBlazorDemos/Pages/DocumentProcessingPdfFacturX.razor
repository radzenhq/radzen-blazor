@using System.IO
@using System.Text
@using Radzen.Documents
@using Radzen.Documents.Core
@using Radzen.Documents.Pdf
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal">
        <RadzenButton Text="Download e-invoice" Icon="download" ButtonStyle="ButtonStyle.Secondary" Click=@Download />
    </RadzenStack>
    <RadzenText TextStyle="TextStyle.Caption">
        One file, two audiences: a person reads the PDF/A-3 pages, accounting software reads the embedded <code>factur-x.xml</code>.
        The invoice XML comes from your invoicing system - the library guarantees the container: the PDF/A-3 conformance,
        the <code>Alternative</code> attachment relationship, and the Factur-X declaration in the XMP metadata.
    </RadzenText>
    <PdfPreview Data=@pdf />
</RadzenStack>

@code {
    byte[] pdf;

    const string InvoiceXml = """
        <?xml version="1.0" encoding="UTF-8"?>
        <rsm:CrossIndustryInvoice xmlns:rsm="urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100"
            xmlns:ram="urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100"
            xmlns:udt="urn:un:unece:uncefact:data:standard:UnqualifiedDataType:100">
          <rsm:ExchangedDocumentContext>
            <ram:GuidelineSpecifiedDocumentContextParameter>
              <ram:ID>urn:cen.eu:en16931:2017</ram:ID>
            </ram:GuidelineSpecifiedDocumentContextParameter>
          </rsm:ExchangedDocumentContext>
          <rsm:ExchangedDocument>
            <ram:ID>INV-2026-001</ram:ID>
            <ram:TypeCode>380</ram:TypeCode>
            <ram:IssueDateTime><udt:DateTimeString format="102">20260805</udt:DateTimeString></ram:IssueDateTime>
          </rsm:ExchangedDocument>
          <rsm:SupplyChainTradeTransaction>
            <ram:ApplicableHeaderTradeAgreement>
              <ram:SellerTradeParty><ram:Name>Fabrikam, Inc.</ram:Name></ram:SellerTradeParty>
              <ram:BuyerTradeParty><ram:Name>Northwind Traders</ram:Name></ram:BuyerTradeParty>
            </ram:ApplicableHeaderTradeAgreement>
            <ram:ApplicableHeaderTradeDelivery />
            <ram:ApplicableHeaderTradeSettlement>
              <ram:InvoiceCurrencyCode>EUR</ram:InvoiceCurrencyCode>
              <ram:SpecifiedTradeSettlementHeaderMonetarySummation>
                <ram:TaxBasisTotalAmount>7896.00</ram:TaxBasisTotalAmount>
                <ram:TaxTotalAmount currencyID="EUR">1579.20</ram:TaxTotalAmount>
                <ram:GrandTotalAmount>9475.20</ram:GrandTotalAmount>
                <ram:DuePayableAmount>9475.20</ram:DuePayableAmount>
              </ram:SpecifiedTradeSettlementHeaderMonetarySummation>
            </ram:ApplicableHeaderTradeSettlement>
          </rsm:SupplyChainTradeTransaction>
        </rsm:CrossIndustryInvoice>
        """;

    protected override async Task OnInitializedAsync()
    {
        var font = await Http.GetByteArrayAsync("fonts/LiberationSans-Regular.ttf");

        var document = new Document();
        document.Info.Title = "Invoice INV-2026-001";
        document.Fonts.Register("Liberation Sans", new MemoryStream(font));

        var section = document.Sections.Add();
        section.Margins.SetAll(48);
        var title = section.Blocks.Add(new Paragraph("Invoice INV-2026-001"));
        title.Font.Family = "Liberation Sans";
        title.Font.Size = 16;
        title.Font.Color = Color.FromRgb(25, 118, 210);
        section.Blocks.Add(new Paragraph("Fabrikam, Inc. -> Northwind Traders")).Font.Family = "Liberation Sans";
        section.Blocks.Add(new Paragraph("Total: 9,475.20 EUR (incl. 20% VAT), due within 14 days.")).Font.Family = "Liberation Sans";

        var portable = new DocumentRenderer { Conformance = PdfAConformance.PdfA3B }.Render(document);
        var attachment = portable.Attachments.Add(
            "factur-x.xml",
            Encoding.UTF8.GetBytes(InvoiceXml),
            AttachmentRelationship.Alternative,
            "text/xml");
        attachment.FacturX = new FacturXProfile
        {
            DocumentType = "INVOICE",
            Version = "1.0",
            ConformanceLevel = "EN 16931",
        };

        pdf = portable.ToArray();
    }

    async Task Download()
    {
        using var stream = new MemoryStream(pdf);
        using var streamRef = new DotNetStreamReference(stream);
        await JSRuntime.InvokeVoidAsync("Radzen.downloadFile", "factur-x-invoice.pdf", streamRef, "application/pdf");
    }
}
