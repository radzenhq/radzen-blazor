@page "/ui-blocks-filter-panels"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Filter Panel blocks
</RadzenText>

<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1000px;">
    A filter panel block lets users narrow a list or grid to what matters. These layouts cover sidebar filters, toolbars, and applied-filter chips.
</RadzenText>

<RadzenText Anchor="ui-blocks-filter-panels#sidebar-filters" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Sidebar filters
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A filter block with checkbox groups and a price range beside the results.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/filter-panels/sidebar-filters" Title="Sidebar filters" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-filter-panels#filter-toolbar" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Filter toolbar
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A filter block with search, dropdown filters, and a sort control in one row.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/filter-panels/filter-toolbar" Title="Filter toolbar" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-filter-panels#applied-filter-chips" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Applied filter chips
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A filter block showing the active filters as removable chips with a result count.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/filter-panels/applied-filter-chips" Title="Applied filter chips" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-filter-panels#collapsible-filters" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Collapsible filters
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A filter block with accordion groups, useful when there are many filter dimensions.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/filter-panels/collapsible-filters" Title="Collapsible filters" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

