@using System.IO
@using Radzen.Documents
@using Radzen.Documents.Pdf
@inject IJSRuntime JSRuntime

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
        <RadzenTextBox @bind-Value=@text style="flex: 1" aria-label="text" Change=@(_ => Generate()) />
        <RadzenButton Text="Download PDF" Icon="download" ButtonStyle="ButtonStyle.Secondary" Click=@Download />
    </RadzenStack>
    <PdfPreview Data=@pdf />
</RadzenStack>

@code {
    string text = "Hello, world!";
    byte[] pdf;

    protected override void OnInitialized()
    {
        Generate();
    }

    void Generate()
    {
        var document = new Document();
        document.Info.Title = "Hello world";

        document.Sections.Add().Blocks.Add(new Paragraph(text));

        pdf = document.ToPdf();
    }

    async Task Download()
    {
        using var stream = new MemoryStream(pdf);
        using var streamRef = new DotNetStreamReference(stream);
        await JSRuntime.InvokeVoidAsync("Radzen.downloadFile", "hello-world.pdf", streamRef, "application/pdf");
    }
}
