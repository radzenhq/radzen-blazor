@page "/ui-blocks-team"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Team blocks
</RadzenText>

<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1000px;">
    A team block introduces the people behind a product or company. It puts faces to names with photos, roles, and short bios, adding a personal touch that builds trust with visitors.
</RadzenText>

<RadzenText Anchor="ui-blocks-team#team-grid" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Team grid
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A team block with a centered heading and a grid of photos, names, and roles.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/team/team-grid" Title="Team grid" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-team#team-cards" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Team cards
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A team block with each member in a card together with contact links.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Light">
                <UIBlock Path="/team/team-cards" Title="Team cards" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

