@page "/ai"

<PageTitle>Blazor AI Components — Chat, Agents, Smart Paste, MCP Server & IDE Integration</PageTitle>

<HeadContent>
    <meta name="description" content="Add AI to your Blazor apps with RadzenAIChat, RadzenAIPrompt, RadzenSmartPasteButton, AI-powered DataGrid, Scheduler and Chart demos and Radzen Blazor MCP. Built on Microsoft.Extensions.AI with tool calling, approvals and generative UI.">
</HeadContent>

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Blazor AI Components
</RadzenText>
<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4">
    Radzen.Blazor includes AI components built on Microsoft.Extensions.AI - chat with tool calling and approvals, a prompt box, smart paste and AI-powered DataGrid, Scheduler and Chart scenarios - and a cloud-hosted MCP server that gives AI coding assistants access to Radzen Blazor documentation and templates.
</RadzenText>
<RadzenStack Gap="3rem">
<RadzenStack Gap="1rem" class="rz-my-6">
    <RadzenText TextStyle="TextStyle.DisplayH3" Text="AI components and demos" TagName="TagName.H2"></RadzenText>
    <RadzenText>
        Everything below talks to the model through the <code>IChatClient</code> abstraction of <strong>Microsoft.Extensions.AI</strong>: bring any OpenAI-compatible endpoint or register the <code>IChatClient</code> of your provider (OpenAI, Azure OpenAI, Ollama and others) and all components use it.
    </RadzenText>
    <RadzenRow Gap="1rem">
        @foreach (var demo in aiDemos)
        {
            <RadzenColumn Size="12" SizeMD="6" SizeXL="4">
                <RadzenLink Path="@demo.Path" Style="text-decoration: none; display: block; height: 100%">
                    <RadzenCard Variant="Variant.Outlined" class="rz-h-100">
                        <RadzenStack Gap="0.5rem">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenIcon Icon="@demo.Icon" class="rz-color-primary" />
                                <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3" class="rz-m-0">@demo.Title</RadzenText>
                                @if (demo.IsNew)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Shade="Shade.Lighter" Text="New" />
                                }
                            </RadzenStack>
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0 rz-color-secondary">@demo.Description</RadzenText>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenLink>
            </RadzenColumn>
        }
    </RadzenRow>
</RadzenStack>
<RadzenRow AlignItems="AlignItems.Center" class="rz-my-6">
    <RadzenColumn Size="12" SizeLG="6" Order="2">
        <RadzenStack Gap="1.5rem" AlignItems="AlignItems.Start">
            <RadzenText TextStyle="TextStyle.DisplayH3" Text="RadzenAIChat" TagName="TagName.H2"></RadzenText>
            <RadzenText>
                <strong>RadzenAIChat</strong> is a Blazor-native chat component built on <strong>Microsoft.Extensions.AI</strong>. It works with any OpenAI-compatible service out of the box and with any <code>IChatClient</code> provider (OpenAI, Azure OpenAI, Ollama, local servers, or third-party providers). Because it is built on <code>IChatClient</code>, an AG-UI agent backend plugs in through the AG-UI .NET SDK without changes to the UI.
            </RadzenText>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenIcon Icon="task_alt" />
                    <RadzenText>Works with any OpenAI API-compatible endpoint or Microsoft.Extensions.AI IChatClient</RadzenText>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenIcon Icon="task_alt" />
                    <RadzenText>Tool calling with your C# methods, human-in-the-loop approvals and generative UI with Radzen components</RadzenText>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenIcon Icon="task_alt" />
                    <RadzenText>Supports streaming, theming, message history, and extensibility</RadzenText>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenIcon Icon="task_alt" />
                    <RadzenText>Ideal for embedding AI assistants directly into your Blazor apps</RadzenText>
                </RadzenStack>
            </RadzenStack>
            <RadzenLink Text="RadzenAIChat live demo" Path="/aichat" class="rz-button rz-button-lg rz-variant-outlined rz-primary rz-shade-default rz-w-auto rz-w-lg-100 rz-text-align-center rz-my-4" Style="--rz-link-hover-text-decoration: none;"></RadzenLink>
        </RadzenStack>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeLG="5" SizeXL="4" Order="1" class="rz-text-align-center">
        <RadzenCard Variant="Variant.Flat" class="rz-background-color-success-lighter rz-color-black rz-p-12 rz-w-fit-content rz-max-w-100" Style="min-width: 10vh; border-radius: 50%; margin: 0 auto;">
            <RadzenIcon Icon="chat" Style="font-size: 10vh; font-weight: 300;" class="rz-m-12" />
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>
<RadzenRow AlignItems="AlignItems.Center" class="rz-my-6" ID="special-offer">
    <RadzenColumn Size="12" SizeLG="6" Order="2">
        <RadzenStack Gap="1.5rem" AlignItems="AlignItems.Start">
            <RadzenText TextStyle="TextStyle.DisplayH3" Text="Radzen Blazor MCP" TagName="TagName.H2"></RadzenText>
            <RadzenText>
                <strong>Radzen Blazor MCP</strong> is a cloud-hosted <strong>Model Context Protocol (MCP)</strong> server that gives AI coding assistants real-time access to Radzen Blazor component documentation, APIs, and templates.
            </RadzenText>
            <RadzenText>
                No packages to install — works with Cursor, Claude Code, GitHub Copilot, JetBrains, Windsurf, and other MCP-capable tools.
            </RadzenText>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenIcon Icon="task_alt" />
                    <RadzenText>Component API docs, ready-made templates, and usage guides for 145+ components</RadzenText>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenIcon Icon="task_alt" />
                    <RadzenText>Semantic search over complete Radzen Blazor documentation — always up to date</RadzenText>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenIcon Icon="task_alt" />
                    <RadzenText>Free trial available — unlimited access included with Radzen Blazor Pro and Team subscriptions</RadzenText>
                </RadzenStack>
            </RadzenStack>
            <RadzenLink Text="Learn more about Radzen Blazor MCP" Path="https://www.radzen.com/blazor-mcp/" class="rz-button rz-button-lg rz-variant-outlined rz-primary rz-shade-default rz-w-auto rz-w-lg-100 rz-text-align-center rz-my-4" Style="--rz-link-hover-text-decoration: none;"></RadzenLink>
        </RadzenStack>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeLG="5" SizeXL="4" Order="1" class="rz-text-align-center">
        <RadzenCard Variant="Variant.Flat" class="rz-background-color-primary-lighter rz-p-12 rz-w-fit-content rz-max-w-100" Style="min-width: 10vh; border-radius: 50%; margin: 0 auto;">
            <RadzenImage Path="images/mcp.svg" Style="width: 10vh;" class="rz-m-12" AlternateText="Model Context Protocol (MCP)" />
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>
</RadzenStack>

@code {
    record AIDemo(string Title, string Path, string Icon, string Description, bool IsNew);

    AIDemo[] aiDemos =
    [
        new("AIChat", "/aichat", "chat", "Streaming chat with conversation memory, Markdown rendering and runtime model configuration.", false),
        new("Tool calling", "/aichat#tools", "build", "The model calls your C# methods; every call is shown as a card with arguments, status and result.", true),
        new("Generative UI", "/aichat#generative-ui", "dashboard", "Render tool results with Radzen components - a chart or a data grid inside the conversation.", true),
        new("Human in the loop", "/aichat#approval", "verified_user", "Wrap a tool in ApprovalRequiredAIFunction and the chat asks the user before it runs.", true),
        new("AIPrompt", "/aiprompt", "auto_awesome", "A prompt box with suggestions, a streaming output and commands such as summarize, rewrite and translate.", true),
        new("SmartPasteButton", "/smartpastebutton", "content_paste_go", "Fill a form from the clipboard - the model extracts the fields of your form model from any text.", true),
        new("DataGrid AI assistant", "/datagrid-ai-assistant", "table_view", "Filter, sort, group and arrange a DataGrid in natural language through grid API tools.", true),
        new("DataGrid AI column", "/datagrid-ai-column", "view_column", "A column with values generated by the model for the rows of the current page in one request.", true),
        new("DataGrid semantic search", "/datagrid-semantic-search", "manage_search", "Find rows by meaning: rows and the query are embedded and ranked by similarity.", true),
        new("Scheduler AI assistant", "/scheduler#ai-assistant", "event", "Read, add, move and delete appointments by chatting, with approval for every change.", true),
        new("Chart AI insights", "/chart-ai-insights", "insights", "Ask questions about a chart - AIPrompt gets the series as context and answers with the numbers.", true),
        new("Voice input", "/aichat#voice", "mic", "Talk to the assistant with RadzenSpeechToTextButton and the browser's speech recognition.", true),
        new("AI UI Blocks", "/ui-blocks-ai", "widgets", "Ready-made welcome screens, prompt suggestions and ask bars built around RadzenAIChat.", false)
    ];
}
