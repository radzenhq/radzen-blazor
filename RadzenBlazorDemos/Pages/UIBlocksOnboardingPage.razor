    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-onboarding#vertical-steps" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Vertical steps
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
