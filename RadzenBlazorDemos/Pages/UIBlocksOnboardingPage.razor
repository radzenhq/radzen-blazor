@page "/ui-blocks-onboarding"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Onboarding blocks
</RadzenText>

<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1000px;">
    An onboarding block walks users through a multi-step process: setting up an account, configuring a workspace, or completing a wizard. Clear progress and small steps keep completion rates high.
</RadzenText>

<RadzenText Anchor="ui-blocks-onboarding#steps-wizard" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Steps wizard
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    An onboarding block using the Steps component with navigation between steps.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/onboarding/steps-wizard" Title="Steps wizard" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

<RadzenText Anchor="ui-blocks-onboarding#progress-checklist" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Progress checklist
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
