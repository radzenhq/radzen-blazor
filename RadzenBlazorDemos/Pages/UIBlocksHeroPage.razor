@page "/ui-blocks-hero"

<RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1" class="rz-pt-8">
    Hero blocks
</RadzenText>

<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-pb-4" Style="max-width: 1000px;">
    A hero block is the first section visitors see on a page. It combines a strong headline, supporting text, and primary actions to communicate the value of a product or service at a glance and invite users to take the next step.
</RadzenText>

<RadzenText Anchor="ui-blocks-hero#centered-hero" TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-pt-12">
    Centered hero
</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-8">
    A hero block with centered content and a product image below the actions.
</RadzenText>
<RadzenCard class="rz-p-0 rz-material-3-demo-card">
    <RadzenTabs class="example-tabs">
        <Tabs>
            <RadzenTabsItem Text="Theme's default">
                <UIBlock Path="/hero/centered-hero" Title="Centered hero" />
            </RadzenTabsItem>
            <UIBlocks />
        </Tabs>
    </RadzenTabs>
</RadzenCard>

